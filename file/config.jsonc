
{
  // ==================================
  // WAYBAR - MAIN CONFIGURATION
  // ==================================

  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 8,

  // LEFT SIDE
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],

  // CENTER
  "modules-center": [
    "clock"
  ],

  // RIGHT SIDE
  "modules-right": [
    "tray",
    "network",
    "pulseaudio",
    "battery",
    "custom/power"
  ],

  // ==================================
  // APP LAUNCHER
  // ==================================
  "custom/launcher": {
    "format": "󰣇",
    "tooltip": "Open App Launcher",
    "on-click": "rofi -show drun"
  },

  // ==================================
  // WORKSPACES
  // ==================================
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    "persistent-workspaces": {
      "*": 5
    }
  },

  // ==================================
  // CLOCK
  // ==================================
  "clock": {
    "format": "  {:%H:%M}",
    "format-alt": "  {:%A, %d %B %Y}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  // ==================================
  // SYSTEM TRAY
  // ==================================
  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  // ==================================
  // NETWORK
  // ==================================
  "network": {
    "format-wifi": "󰖩  {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  // ==================================
  // AUDIO
  // ==================================
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  // ==================================
  // BATTERY
  // ==================================
  "battery": {
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },

  // ==================================
  // POWER BUTTON
  // ==================================
  "custom/power": {
    "format": "󰐥",
    "tooltip": "Power Menu",
    "on-click": "wlogout"
  }
}
